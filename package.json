{
  "name": "noroshi",
  "version": "0.0.0-pre.3",
  "description": "Grammar Prompting for browser LLMs — constrained DSL output without fine-tuning",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx examples/creative-coding-p5js/test.ts && tsx examples/creative-coding-p5js/test-fetch.ts && tsx examples/creative-coding-p5js/test-safety.ts && tsx examples/creative-coding-p5js/test-ranker.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "llm",
    "grammar-prompting",
    "structured-output",
    "browser-llm",
    "litert-lm",
    "transformers-js",
    "webllm",
    "dsl",
    "constrained-generation",
    "on-device"
  ],
  "author": "Velocity LABO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velocitylabo/noroshi.git"
  },
  "bugs": {
    "url": "https://github.com/velocitylabo/noroshi/issues"
  },
  "homepage": "https://github.com/velocitylabo/noroshi#readme",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.22.1",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
